[
  {
    "context": "VimControl && !menu",
     "bindings": {
      "space space": "file_finder::Toggle",
      "space t": "workspace::NewTerminal",
      "space e": "vim::ToggleProjectPanelFocus",
      "space ,": "workspace::ReopenLastPicker",
      "space d": "editor::GoToDefinition",
      "space shift-r": "editor::FindAllReferences",
      "space i": "editor::GoToImplementation",
      "space w o": "workspace::CloseInactiveTabsAndPanes",
      "space shift-H": "editor::ToggleInlayHints",
}
  },

  {
    "context": "vim_mode == insert && !menu",
    "bindings": {
      "j k": "vim::NormalBefore"
    }
  },

  {
    "context": "vim_mode == normal && !menu",
    "bindings": {
      "g w": "vim::HelixJumpToWord"
    }
  }
]
