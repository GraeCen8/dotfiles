
{
    "layer": "top",
    "position": "top",
    "height": 24,
    "spacing": 8,

    "modules-left": [
        "niri/workspaces",
        "niri/window"
    ],

    "modules-right": [
        "tray",
        "cpu",
        "memory",
        "network",
        "pulseaudio",
        "clock"
    ],

    "tray": {
        "spacing": 10,
        "icon-size": 18
    },

    "niri/window": {
        "format": "{title}",
        "max-length": 150,
        "separate-outputs": true
    },

    "clock": {
        "format": "{:%Y-%m-%d %H:%M:%S}",
        //"tooltip-format": "<tt>{calendar}</tt>",
        "tooltip-format": "<tt><span font='Iosevka Nerd Font' size='18pt'><b>{calendar}</b></span></tt>",
        "calendar": {
            "mode": "month",
            "mode-mon-col": 3,
            "weeks-pos": "right",
            "on-scroll": 1,
            "on-click-right": "mode",
            "format": {
                "months": "<span color='#78a9ff'><b>{}</b></span>",
                "days": "<span color='#dde1e6'>{}</span>",
                "weeks": "<span color='#ee5396'>W{}</span>",
                "weekdays": "<span color='#8d8d8d'><b>{}</b></span>",
                "today": "<span color='#33b1ff'><b><u>{}</u></b></span>"
            }
        },
        "interval": 1
    },

    "cpu": {
        "interval": 5,
        "format": "CPU {usage}%",
        "states": { "warning": 70, "critical": 90 },
        "on-click": "kitty -e btop"
    },

    "memory": {
        "interval": 5,
        "format": "MEM {percentage}%",
        "states": { "warning": 70, "critical": 90 },
        "tooltip-format": "{used:0.1f} GiB / {total:0.1f} GiB",
        "on-click": "kitty -e btop"
    },

    "backlight": {
        "format": "BRT {percent}%",
        "on-scroll-up": "brightnessctl set 5%+",
        "on-scroll-down": "brightnessctl set 5%-"
    },

    "battery": {
        "interval": 30,
        "states": {
            "warning": 20,
            "critical": 10
        },
        "format": "BAT {capacity}%",
        "format-charging": "CHG {capacity}%",
        "format-plugged": "AC {capacity}%",
        "tooltip-format": "{timeTo} · {power}W"
    },

    "network": {
        "format-ethernet": "NET",
        "format-wifi": "NET {signalStrength}%",
        "format-disconnected": "NET --",
        "tooltip-format": "Network Information\n\nSSID: {essid}\nIP: {ipaddr}\nBand: {frequency} MHz\nSignal: {signalStrength}%   \nvia: {ifname}",
        "tooltip-format-disconnected": "no connection"
  },

    "pulseaudio": {
        "format": "VOL {volume}%",
        "format-muted": "MUTE",
        "scroll-step": 5,
        "tooltip-format": "{desc}",
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
    },
}
